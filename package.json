{
  "name": "remote-sync-player",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "node --env-file-if-exists=apps/web/.env scripts/dev.mjs",
    "build": "pnpm -r build",
    "deploy": "pnpm --filter @project/web build && pnpm --filter @project/signal exec wrangler deploy --env production",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && prettier --check .",
    "test": "node --test scripts/signal-dev.test.mjs && vitest run --passWithNoTests && pnpm --filter @project/signal test",
    "e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
}
